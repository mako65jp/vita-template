{
    "backend": {
        "protocol": "http",
        "host": "localhost",
        "port": 3000,
        "applicationRoot": "/api"
    },
    "database": {
        "type": "postgres",
        "connectionString": "postgresql://postgres:postgres@db:5432/app_db"
    },
    "authentication": {
        "type": "local",
        "secret": "change-this-secret"
    },
    "administration": {
        "enabled": true,
        "authentication": {
            "type": "local"
        }
    },
    "features": {
        "user": true
    },
    "frontend": {
        "type": "react"
    }
}
